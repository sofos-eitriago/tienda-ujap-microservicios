# Copia este archivo como .env y cambia los valores.
# Usa solo letras y números en las contraseñas de las bases de datos (van dentro de URLs de conexión).

# PostgreSQL (servicio-usuarios y servicio-pedidos)
DB_USER=admin
DB_PASS=cambia_esta_clave
DB_NAME=tienda

# MongoDB (servicio-productos y servicio-actividad)
MONGO_USER=admin
MONGO_PASS=cambia_esta_clave
MONGO_DB=tienda

# JWT: secreto compartido por los 4 microservicios (mínimo 32 caracteres).
# Genera uno con:  python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=cambia-este-secreto-por-uno-aleatorio-de-64-caracteres
JWT_EXPIRA_MIN=60

# Cuenta de administrador que se crea al iniciar por primera vez
ADMIN_EMAIL=admin@tienda.com
ADMIN_PASSWORD=cambia_esta_clave

# Puerto del API Gateway en tu máquina (80 = enlace sin número de puerto)
GATEWAY_PORT=80
