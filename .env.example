# Copia este archivo como .env y cambia los valores.
# Usa solo letras y números en las contraseñas de las bases de datos (van dentro de URLs de conexión).

# PostgreSQL (servicio-usuarios y servicio-pedidos)
DB_USER=admin
DB_PASS=cambia_esta_clave
DB_NAME=tienda

# MongoDB (servicio-productos y servicio-actividad)
MONGO_USER=admin
MONGO_PASS=cambia_esta_clave
MONGO_DB=tienda

# JWT: secreto compartido por los 4 microservicios (mínimo 32 caracteres).
# Genera uno con:  python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=cambia-este-secreto-por-uno-aleatorio-de-64-caracteres
JWT_EXPIRA_MIN=60

# Cuenta de administrador que se crea al iniciar por primera vez
ADMIN_EMAIL=admin@tienda.com
ADMIN_PASSWORD=cambia_esta_clave

# Puertos del API Gateway en tu máquina (80 y 443 = enlace sin número de puerto).
# Lo que entra por HTTP se redirige a HTTPS.
GATEWAY_PORT=80
GATEWAY_PORT_HTTPS=443

# Correo. Sin cambiar nada, los correos (códigos y avisos de pedidos) llegan al buzón de pruebas
# Mailpit: http://localhost:8025. Para enviarlos de verdad, pon los datos de un servidor SMTP
# (por ejemplo Gmail: smtp.gmail.com, puerto 587, STARTTLS true y una "contraseña de aplicación").
MAILPIT_PORT=8025
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USUARIO=
SMTP_CLAVE=
SMTP_STARTTLS=false
CORREO_REMITENTE=Tienda UJAP <no-responder@tienda.ujap.test>

